{
    "compilerOptions": {
        "target": "ES6",
        "module": "ESNext",
        "lib": ["DOM", "ESNext"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "paths": {
            "@api/*": ["./src/api/*"],
            "@assets/*": ["./src/assets/*"],
            "@components/*": ["./src/components/*"],
            "@contexts/*": ["./src/contexts/*"],
            "@hooks/*": ["./src/hooks/*"],
            "@layouts/*": ["./src/layouts/*"],
            "@models/*": ["./src/models/*"],
            "@pages/*": ["./src/pages/*"],
            "@routes/*": ["./src/routes/*"],
            "@services/*": ["./src/services/*"],
            "@styles/*": ["./src/styles/*"],
            "@utils/*": ["./src/utils/*"]
        }
    },
    "include": ["src", "src/**/*.d.ts"],
    "exclude": ["node_modules"]
}
