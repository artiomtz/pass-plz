{
    "compilerOptions": {
        "target": "ES6",
        "module": "ESNext",
        "lib": ["DOM", "ESNext"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "Node",
        "jsx": "react-jsx",
        "baseUrl": "src",
        "paths": {
            "@api/*": ["api/*"],
            "@components/*": ["components/*"],
            "@contexts/*": ["contexts/*"],
            "@hooks/*": ["hooks/*"],
            "@layouts/*": ["layouts/*"],
            "@models/*": ["models/*"],
            "@pages/*": ["pages/*"],
            "@routes/*": ["routes/*"],
            "@services/*": ["services/*"],
            "@styles/*": ["styles/*"],
            "@utils/*": ["utils/*"]
        }
    },
    "include": ["src", "src/**/*.d.ts"],
    "exclude": ["node_modules"]
}
