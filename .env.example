ADMIN_EMAIL=admin@email.com
USER_PASSWORD_MIN_LENGTH=12

AES_ENCRYPTION_KEY=aes_encryption_key
JWT_ENCRYPTION_KEY=jwt_encryption_key

EMAIL_HOST=host@email.com
EMAIL_KEY=email_key
EMAIL_BANNER=https://cdn.com/images/banner.jpg

LOGS_PATH=logs
LOGS_NUM_KEEP=100
LOGS_FILE_SIZE_LIMIT=1MB
LOGS_ALL_SIZE_LIMIT=10MB

###### PROD BACKEND
DB_DATA_PATH=/var/lib/postgresql
DB_URL=jdbc:postgresql://db.host.com:6543/postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres
ADMIN_PASSWORD=admin_pass
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_MINUTES=1440
EMAIL_TOKEN_EXPIRY_MINUTES=30
FRONTEND_URL=https://frontend.com

###### PROD FRONTEND
VITE_BACKEND_URL=https://backend.com

